{
  "name": "maildesk",
  "version": "0.1.0",
  "private": true,
  "description": "MailDesk - a quiet IMAP mail client (receive only)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:portable": "npm run build && electron-builder --win portable --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "electron-log": "^5.4.4",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.12.2",
    "libmime": "^5.6.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
